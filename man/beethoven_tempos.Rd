# Compare tempo choices across conductor types
library(dplyr)
library(ggplot2)

# Average tempo deviation from Beethoven's marks by conductor type
beethoven_tempos \%>\%
  group_by(ptype, mark) \%>\%
  summarise(
    median_tempo = median(tempo),
    deviation = median_tempo - first(mark)
  ) \%>\%
  ggplot(aes(x = mark, y = median_tempo, color = ptype)) +
  geom_point() +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
  labs(x = "Beethoven's Mark (BPM)", 
       y = "Performed Tempo (BPM)",
       color = "Performance Type")

# Tempo variation within a single movement
beethoven_tempos \%>\%
  filter(symphony == 3, movement == 1, conductor == "Abbado, Claudio") \%>\%
  ggplot(aes(x = start, y = tempo)) +
  geom_line() +
  geom_hline(yintercept = 112, linetype = "dashed", color = "red") +
  labs(x = "Time (seconds)", y = "Tempo (BPM)",
       title = "Tempo fluctuations: Symphony 3, Movement 1",
       subtitle = "Red line = Beethoven's mark (112 BPM)")
